<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.x4rm.opencode4j</groupId>
        <artifactId>opencode4j</artifactId>
        <version>0.1.0-alpha.2</version>
    </parent>

    <artifactId>opencode4j-examples</artifactId>
    <packaging>jar</packaging>

    <name>opencode4j-examples</name>
    <description>Runnable examples and test harnesses for opencode4j.</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.x4rm.opencode4j</groupId>
            <artifactId>opencode4j-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.x4rm.opencode4j</groupId>
            <artifactId>opencode4j-agent</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.opencode4j.examples.RunPrompt</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
